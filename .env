# ── Ohmlet / Digital Twin — Phase 1 Telemetry Spine ──
#
# Copy to .env.local (or set in your shell) to run the app. All values are
# optional: without ARDUINO_SERIAL_PORT the twin runs simulation-only and the
# UI falls back to its in-browser solar-tracker simulation.

# Gemini API key (Live Tutor / AI Copilot backend).
GEMINI_API_KEY="AIzaSyD3hOy0WDkG6dFkZUwQKebJIbbTPU4hC1o"

# ── Telemetry Spine ──
# Physical Arduino UNO serial bridge. Leave unset to disable the physical link
# (simulation-only mode). On Windows use the COM port, e.g. COM10.
ARDUINO_SERIAL_PORT=COM10
# Baud rate the Arduino firmware prints at (Arduino side: Serial.begin(9600)).
ARDUINO_SERIAL_BAUD=9600
# Identity stamped on every canonical TelemetryFrame (device + project).
TWIN_DEVICE_ID=arduino-uno-solar-tracker
TWIN_PROJECT_ID=solar-tracker-digital-twin

# ── Optional backends (inert when unset) ──
# Firebase / Auth (dev fallbacks are committed in services/firebase.ts).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_OHMLET_API_BASE_URL=            # user-state persistence backend
# VITE_OHMLET_REPORTER_API_BASE_URL=   # 3D digital-twin (photo→GLB) backend
# VITE_OHMLET_ADMIN_EMAILS=            # comma-separated admin allowlist

